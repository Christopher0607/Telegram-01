# ======================================================
#  复制成 .env 后填写：cp .env.example .env && nano .env
#  （每行一个值，等号两边不要有空格，不要加引号）
# ======================================================

# ---- Telegram 账号 API：https://my.telegram.org → API development tools ----
TG_API_ID=
TG_API_HASH=
# 监听账号的手机号，带国家码，例如 +8613800000000
TG_PHONE=

# ---- 通知机器人：在 @BotFather 新建一个（不要和博悦 V9 共用同一个）----
TG_BOT_TOKEN=
# 留空 = 自动用监听账号自己的 id；如果监听用的是小号，这里填你大号的数字 id
TG_OWNER_ID=

# ---- AI 解析 ----
DEEPSEEK_API_KEY=
# 只有 config.yaml 里 llm.provider 选 anthropic 才需要
ANTHROPIC_API_KEY=

# ---- 交易所 API（只跑模拟盘时可以先不填；用哪个由 config.yaml 的 exchange.name 决定）----
# 建议：单独建一个子账户跟单；API 只给「合约交易」权限，不给提现；绑定服务器 IP
GATE_API_KEY=
GATE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
